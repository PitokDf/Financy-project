// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique @db.VarChar(255)
  password String? @db.VarChar(125) // hashed with bcrypt, null for Google OAuth users
  name     String  @db.VarChar(125)
  avatar   String? @db.VarChar(255) // URL to avatar image

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  transactions      Transaction[]
  categories        Category[]
  budgetGoals       BudgetGoal[]
  notifications     Notification[]
  userStats         UserStats?
  userBadges        UserBadge[]
  userChallenges    UserChallenge[]
  forecasts         Forecast[]
  userSetting       UserSetting?
  pushSubscriptions PushSubscription[]
  scheduledExpenses  ScheduledExpense[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserStats {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // XP and Level
  xp    Int @default(0)
  level Int @default(1)

  // Streak tracking
  streak            Int       @default(0)
  longestStreak     Int       @default(0) @map("longest_streak")
  lastTransactionAt DateTime? @map("last_transaction_at")

  // Stats
  totalTransactions Int @default(0) @map("total_transactions")
  totalIncome       Int @default(0) @map("total_income")
  totalExpense      Int @default(0) @map("total_expense")

  // Gamification flags
  hasExported Boolean @default(false) @map("has_exported")
  hasAnalyzed Boolean @default(false) @map("has_analyzed")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Badge {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.VarChar(255)
  description String @db.Text
  icon        String @db.VarChar(50) // Icon name (e.g., "Star", "Flame", "Trophy")
  condition   String @db.VarChar(100) // Condition code (e.g., "streak_7", "transactions_50")
  xpReward    Int    @default(0) @map("xp_reward")
  color       String @default("#FFD700") @db.VarChar(7) // Badge color

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  badgeId    String   @map("badge_id") @db.Uuid
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Challenge {
  id          String        @id @default(uuid()) @db.Uuid
  title       String @db.VarChar(255)
  description String @db.Text
  target      Int // Target number to achieve
  xpReward    Int           @default(50) @map("xp_reward")
  type        ChallengeType @default(WEEKLY_TRANSACTIONS)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userChallenges UserChallenge[]

  @@map("challenges")
}

model UserChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  challengeId String    @map("challenge_id") @db.Uuid
  current     Int       @default(0) // Current progress
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  deadline    DateTime // Challenge deadline (usually end of week)
  weekNumber  Int       @map("week_number") // ISO week number
  year        Int // Year for tracking

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, weekNumber, year])
  @@map("user_challenges")
}

enum ChallengeType {
  WEEKLY_TRANSACTIONS
  MONTHLY_SAVINGS
  BUDGET_GOALS
  ANALYSIS_COUNT
  STREAK_MAINTAIN
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  description String @db.Text
  amount      Int // Amount in IDR (smallest unit)
  type        TransactionType
  date        DateTime        @db.Date

  // Optional category
  categoryId String? @map("category_id") @db.Uuid

  // Clustering
  clusterId String? @map("cluster_id") @db.Uuid

  // Source tracking
  source      TransactionSource @default(MANUAL) @map("source")
  csvImportId String?           @map("csv_import_id")

  // AI review flag
  needsReview Boolean @default(false) @map("needs_review")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  cluster  Cluster?  @relation(fields: [clusterId], references: [id])

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("transactions")
}

model ScheduledExpense {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  description     String @db.Text
  amount          Int
  categoryId      String?   @map("category_id") @db.Uuid
  dayOfMonth      Int       @map("day_of_month") // 1-31
  isActive        Boolean   @default(true) @map("is_active")
  lastProcessedAt DateTime? @map("last_processed_at") // last month-year this was executed
  lastNotifiedDay Int?      @map("last_notified_day") // last dayOfMonth a reminder was sent

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@map("scheduled_expenses")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  CSV_IMPORT
  API
}

model Category {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  name            String @db.VarChar(125)
  color           String          @default("#888888") @db.VarChar(7)
  icon            String? @db.VarChar(255) // Icon name
  type            TransactionType @default(EXPENSE)
  isAutoGenerated Boolean         @default(false) @map("is_auto_generated")

  // AI-generated metadata
  aiConfidence Float?   @map("ai_confidence") // Confidence score from clustering
  aiKeywords   String[] @map("ai_keywords") // Keywords extracted from transactions

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  budgetGoals       BudgetGoal[]
  forecasts         Forecast[]
  scheduledExpenses ScheduledExpense[]

  @@unique([userId, name])
  @@map("categories")
}

model BudgetGoal {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  categoryId String       @map("category_id") @db.Uuid
  amount     Int // Budget limit in IDR
  period     BudgetPeriod @default(MONTHLY)

  // Alert settings
  alertThreshold Int     @default(80) @map("alert_threshold") // Alert at % of budget
  alertSent80    Boolean @default(false) @map("alert_sent_80")
  alertSent100   Boolean @default(false) @map("alert_sent_100")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("budget_goals")
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Cluster {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  analysisRunId String  @map("analysis_run_id") @db.Uuid
  name          String
  suggestedName String? @map("suggested_name") // AI suggested name
  color         String  @default("#888888")
  index         Int     @default(0) // Original cluster index from ML

  // Clustering metrics
  silhouetteScore Float? @map("silhouette_score")
  wcss            Float? // Within-cluster sum of squares

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  analysisRun  AnalysisRun   @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("clusters")
}

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  title   String @db.VarChar(255)
  message String @db.Text
  type    NotificationType
  isRead  Boolean          @default(false) @map("is_read")

  // Additional data (JSON for flexibility)
  metadata Json? @db.JsonB // e.g., { transactionId, categoryId, badgeId, etc. }

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  BUDGET_ALERT // Budget threshold reached
  PATTERN_FOUND // New cluster/pattern discovered
  ACHIEVEMENT // Badge unlocked
  LEVEL_UP // Level increased
  REMINDER // Daily reminder
  STREAK_WARNING // Streak about to break
  CHALLENGE_COMPLETE // Weekly challenge completed
  SCHEDULED_EXPENSE  // Scheduled expense reminder
}


model Forecast {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  categoryId      String  @map("category_id") @db.Uuid
  targetMonth     Int     @map("target_month") // 1-12
  targetYear      Int     @map("target_year")
  predictedAmount Decimal @map("predicted_amount")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, targetMonth, targetYear])
  @@map("forecasts")
}

model AnalysisRun {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  status            String  @default("running") @db.VarChar(255)
  totalTransactions Int     @map("total_transactions")
  kOptimal          Int?    @map("k_optimal") // Optimal number of clusters
  silhouetteScore   Float?  @map("silhouette_score")
  wcssValues        Json?   @map("wcss_values") @db.JsonB // Within-cluster sum of squares values
  durationMs        Int?    @map("duration_ms") // Analysis duration in milliseconds
  errorMessage      String? @map("error_message") @db.Text

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  clusters Cluster[]

  @@index([userId, createdAt])
  @@map("analysis_runs")
}

model UserSetting {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Notification preferences
  pushNotifications Boolean @default(true) @map("push_notifications")
  budgetAlerts      Boolean @default(true) @map("budget_alerts")
  dailyReminder     Boolean @default(true) @map("daily_reminder")
  reminderTime      String  @default("20:00") @map("reminder_time") // HH:MM format
  reminderDays      String[] @default(["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]) @map("reminder_days")
  lastReminderAt    DateTime? @map("last_reminder_at")

  // Display preferences
  currency String @default("IDR")
  language String @default("id") // id = Indonesian

  // Gamification
  showGamification Boolean @default(true) @map("show_gamification")

  // Machine Learning
  autoCategorize   Boolean @default(true) @map("auto_categorize")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
model PushSubscription {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  endpoint String @db.Text
  p256dh   String @db.Text
  auth     String @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}
