NotificationController --> NotificationService
PushController --> PushService
ExportController --> ExportService
ScheduledExpenseController --> ScheduledExpenseService

AuthService --> UserRepository
TransactionService --> TransactionRepository
TransactionService --> GamificationService
TransactionService --> RedisQueue
AnalysisService --> AnalysisRepository
AnalysisService --> CategoryRepository
AnalysisService --> TransactionRepository
AnalysisService --> ForecastService
AnalysisService --> MLService
BudgetService --> BudgetRepository
BudgetService --> RedisQueue
GamificationService --> GamificationRepository
ForecastService --> TransactionRepository
ForecastService --> ForecastRepository
ForecastService --> CategoryRepository
ScheduledExpenseService --> ScheduledExpenseRepository
ScheduledExpenseService --> TransactionRepository
ScheduledExpenseService --> CategoryRepository
ExportService --> TransactionRepository

TransactionRepository --> PostgreSQL
CategoryRepository --> PostgreSQL
BudgetRepository --> PostgreSQL
AnalysisRepository --> PostgreSQL
ForecastRepository --> PostgreSQL
GamificationRepository --> PostgreSQL
NotificationRepository --> PostgreSQL
PushRepository --> PostgreSQL
ScheduledExpenseRepository --> PostgreSQL
UserRepository --> PostgreSQL

RedisQueue --> GamificationService

@enduml
