  "help": {
    "title": "FinTrack Help Center",
    "desc": "Find answers to frequently asked questions, learn about available features, or contact our support team.",
    "contactUs": "Contact Us",
    "emailSupport": "Email Support",
    "whatsapp": "WhatsApp",
    "whatsappDesc": "Chat directly with the developer",
    "faq": "Frequently Asked Questions (FAQ)",
    "featuresTitle": "FinTrack Features",
    "faqData": {
      "q1": "How do I add a transaction?",
      "a1": "Go to the Dashboard or Transactions page, then click the \"+\" button at the bottom center of the screen. Select the transaction type (Income/Expense), fill in the details, and save.",
      "q2": "How do I set up a monthly budget?",
      "a2": "Open the Budget menu from the bottom navigation. You can create a new budget per category for each month. The system will monitor and send notifications if spending approaches the limit.",
      "q3": "How does auto-categorization work?",
      "a3": "FinTrack will automatically read the transaction notes you write (e.g., \"Buy gasoline\") and immediately determine the most suitable category (e.g., \"Transportation\"). If you prefer to categorize it yourself later, you can turn off this feature in the Profile > Preferences > Auto-Categorization menu.",
      "q4": "What is the AI Lab feature?",
      "a4": "AI Lab is a special page to categorize multiple transactions smartly. If you previously turned off the auto-categorization feature and left the transaction categories blank, you can enter this page to quickly tidy up and categorize all those transactions in one click.",
      "q5": "How do I export data?",
      "a5": "Go to Profile > Export Data. You can choose the format (CSV, Excel, or PDF) and the desired period. The file will be immediately downloaded to your device.",
      "q6": "Is my data secure?",
      "a6": "Yes, your data is securely stored on our servers. We use token-based authentication and never store passwords in their raw format.",
      "q7": "How do I enable notifications?",
      "a7": "Go to Profile > enable the \"Push Notifications\" toggle. Make sure your browser allows notifications from FinTrack. You will receive budget reminders and achievements."
    },
    "features": {
      "t1": "Transaction Management",
      "d1": "Record your daily incoming and outgoing money easily. Transaction categories will be automatically filled smartly, and can be enabled or disabled via Profile.",
      "t2": "Financial Analysis",
      "d2": "View spending patterns, cash flow, and category analysis in interactive charts.",
      "t3": "AI Smart Clustering",
      "d3": "AI algorithms group similar transactions to help you understand financial habits.",
      "t4": "Export Report",
      "d4": "Download financial reports in CSV, Excel, or PDF format for your needs.",
      "t5": "Budget & Planner",
      "d5": "Set budgets per category and monitor their realization in real-time.",
      "t6": "Smart Notifications",
      "d6": "Receive reminders when approaching budget limits and reach new achievements."
    }
